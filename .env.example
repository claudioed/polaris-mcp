# Copy to .env and fill in — see README.md for the full variable reference.

# Google OAuth client ID of the Polaris server (required; same client the
# server verifies, with a loopback redirect URI registered).
POLARIS_OIDC_CLIENT_ID=

# Client secret, only for OAuth clients that require it at token exchange.
POLARIS_OIDC_CLIENT_SECRET=

# Ingest secret (X-API-Key) enabling the measurement-submission tools.
POLARIS_INGEST_API_KEY=

# Optional client-side sanity check on the signed-in account.
POLARIS_AUTHORIZED_EMAIL=

# Origin of the running Polaris API as seen from this container: the public
# https origin, http://host.docker.internal:8080 for a host process listening
# on all interfaces, or http://polaris:8080 when sharing the polaris compose
# network (see README.md "Deploy with Docker Compose").
POLARIS_BASE_URL=http://host.docker.internal:8080

# Host port publishing the MCP streamable-http endpoint (loopback only).
POLARIS_MCP_HTTP_PORT=8000

# Tag for the polaris-mcp image: `local` builds from source; a released tag
# (e.g. v0.1.4) deploys the GHCR image instead — `docker compose pull` first.
POLARIS_MCP_TAG=local
